<div class="container py-4">
  <h1>All Messages</h1>
  <div id="chatrooms-list">
    <% if @chatrooms.any? %>
      <ul class="chatroom-item">
        <% @chatrooms.each do |chatroom| %>
          <li><%= link_to chatroom.name, chatroom_path(chatroom) %></li>
        <% end %>
      </ul>
    <% else %>
      <p>You have no messages</p>
    <% end %>
  </div>
</div>
