<% users.each do |user| %>
    <div class="home-card-slot">
      <a href="<%= user_path(user) %>" class="clickable-card">
        <div class="card-user">
          <div class="user-card-avatar">
            <div class="user-card-avatar-center">
              <%= cl_image_tag user.photo.key, class:"user-avatar-img", crop: :fill unless user.photo.key.blank? %>
            </div>
          </div>
          <div class="card-user-infos">
            <div class="title-description">
              <h2><%= "#{user.first_name} #{user.last_name}" %></h2>
              <p>@<%= user.username %></p>
            </div>
            <%= render "shared/tag_pills", user: user %>
            <div class="home-user-about border-top p-2">
              <p><%= user.about %></p>
            </div>
            <div class="price-capacity">
              <div class="capacity-icon"><i class="fa-solid fa-location-dot"></i> <p class="card-user-capacity ms-2"> <%= user.address %></p></div>
              <p class="card-user-pricing"><strong><%= user.years_experience %> <%= "year".pluralize(user.years_experience) %> experience</strong></p>
            </div>
          </div>
        </div>
      </a>
    </div>
  <% end %>
